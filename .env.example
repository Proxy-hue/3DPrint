# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=3dprint
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Django
SECRET_KEY=change-me-to-a-random-secret-with-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=False
USE_SQLITE=False

# SMTP / Mailpit
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@3dprint.local

# Frontend (empty when proxied via nginx, or http://localhost:8000 for local Vite dev)
VITE_API_URL=http://localhost:8000

# Redis task queue
REDIS_URL=redis://127.0.0.1:6379/0
RQ_DEFAULT_TIMEOUT=360
# Set True only for local Windows dev without Redis/Docker (requires DEBUG=True)
SYNC_VALIDATION_FALLBACK=False

# MinIO / S3-compatible model storage (local development defaults)
USE_S3_STORAGE=False
MINIO_BUCKET_NAME=3dprint-models
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
